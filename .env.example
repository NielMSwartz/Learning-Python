# Flask / web application
SECRET_KEY=replace-with-a-long-random-string
FLASK_APP=wsgi.py
FLASK_CONFIG=development
DEBUG=0
PORT=8000

# Database. Example Neon connection string (pooled endpoint recommended):
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Leave blank to use the local SQLite file below during development.
# SQLITE_PATH is a filename inside ./instance, not a full path.
DATABASE_URL=
SQLITE_PATH=python_academy.db
# Docker/production use explicit migrations instead of first-run auto setup.
DISABLE_AUTO_SETUP=0

# Secure code execution service. Inside Docker use http://executor:9000.
EXECUTOR_URL=http://127.0.0.1:9000
EXECUTOR_TOKEN=replace-with-the-same-random-token-in-both-services
EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_MEMORY_MB=192

# Optional e-mail (password reset). Without this, reset links are shown on screen.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Python Academy <noreply@example.com>
PUBLIC_BASE_URL=http://localhost:8000

# Executor service only
EXECUTOR_PORT=9000
EXECUTOR_WORKDIR=/tmp/python-academy-exec
